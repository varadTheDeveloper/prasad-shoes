{
  "expo": {
    "name": "Prasad Shoes",
    "slug": "prasad-shoes",
    "version": "1.0.0",
    "scheme": "prasadshoes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.prasadshoes.labels",
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Prasad Shoes",
      "themeColor": "#1D4ED8"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}