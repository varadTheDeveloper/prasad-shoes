{
  "expo": {
    "name": "Prasad Shoes",
    "slug": "prasad-shoes",
    "version": "1.0.0",
    "scheme": "prasadshoes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.prasadshoes.labels",
      "adaptiveIcon": {
        "backgroundColor": "#F5EAD6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Prasad Shoes",
      "themeColor": "#7A3214"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fc34eb40-c3a2-4f65-858d-95ad558ad5e1"
      }
    }
  }
}
