# Copy to .env and fill in. Never commit .env to Git.
NODE_ENV=production
PORT=3000
# App user: can read/write rows, cannot DROP or ALTER tables
DATABASE_URL=postgres://ps_app:CHANGE_ME@localhost:5432/prasad_shoes
# Owner user: used only by "npm run migrate"
MIGRATE_DATABASE_URL=postgres://ps_owner:CHANGE_ME@localhost:5432/prasad_shoes
# Long random string: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_DAYS=7
# "Send to Owner" (Orders page, owner only): one email with the Word file to OWNER_EMAIL, sent with Resend.
# Resend → Domains: verify your domain; Resend → API Keys: create a key with "Sending access".
OWNER_EMAIL=jodakolhapuri@gmail.com
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="Prasad Shoes <orders@CHANGE_ME.com>"
# Only for development, when the website runs on another port:
# CORS_ORIGINS=http://localhost:8081
