{
  "name": "prasad-shoes-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/migrate.ts src/seed.ts --bundle --platform=node --target=node20 --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "migrate:dev": "tsx src/migrate.ts",
    "seed:dev": "tsx src/seed.ts",
    "test": "tsx --test ../shared/__tests__/*.test.ts test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "docx": "^9.12.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
